# Copy this file to ".env" in the project root and fill in the values.
# ".env" is git-ignored. Never commit real keys or tokens.

# Django
SECRET_KEY=change-me-to-a-long-random-string

# Google login (django-allauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local model (Hugging Face). Qwen2.5-3B-Instruct is public, so HF_TOKEN can stay empty.
# The weights (~6 GB) download automatically the first time the tutor is used.
LOCAL_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
HF_TOKEN=

# External API for the second AI feature: Google Gemini (get a key at https://aistudio.google.com/apikey)
API_PROVIDER=gemini
API_KEY=
# "gemini-flash-latest" always points at a current Flash model. To pin one instead, run
# `python manage.py check_gemini --list-models` and copy a name from the list.
API_MODEL=gemini-flash-latest
