# Copy this file to ".env" in the project root and fill in the values.
# ".env" is git-ignored. Never commit real keys or tokens.

# Django
SECRET_KEY=change-me-to-a-long-random-string

# AI Gardening Tutor. Both models are public on Hugging Face; no token or paid API is needed.
# Weights download to ~/.cache/huggingface the first time (LLM ~6 GB, embeddings ~90 MB).
LOCAL_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
# Hard limit for one answer; generation stops after this many seconds.
TUTOR_TIMEOUT_SECONDS=60

# Photo diagnosis (Claude API). Without a key the feature shows a friendly "unavailable" message.
ANTHROPIC_API_KEY=
DIAGNOSIS_MODEL=claude-opus-5-5

# Database (required). PostgreSQL with PostGIS, e.g. Supabase.
DATABASE_URL=postgres://user:password@host:5432/postgres

# Production only (settings.production)
ALLOWED_HOSTS=greenhand.example.com
CSRF_TRUSTED_ORIGINS=https://greenhand.example.com
